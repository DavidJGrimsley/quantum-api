    UE["Braid Breaker — Unreal"]
    UNITY["Unity SDK / Plugin"]
    GODOT["Godot SDK / Plugin"]
    UEP["Unreal Plugin"]

    UE --> UEP

    UNITY --> API
    GODOT --> API
    UEP --> API

    API["Quantum API"]

